# Database
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
MONGO_INITDB_DATABASE=openllm-monitor
MONGO_APP_USERNAME=openllm-user
MONGO_APP_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
MONGODB_URI=mongodb://admin:CHANGE_ME_TO_STRONG_PASSWORD@mongodb:27017/openllm-monitor?authSource=admin
NODE_ENV=development

# Server
PORT=3001
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# Encryption key for API keys stored in DB (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE

# Mongo Express (development only)
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# LLM Provider API Keys
OPENAI_API_KEY=your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# CORS Settings
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
